# Copy this to .env and fill in real values. Never commit .env itself.

RAZORPAY_KEY_ID=your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here

DATABASE_URL=postgresql://user:password@localhost:5432/recovery_agent

# Set to whichever LLM provider you use
ANTHROPIC_API_KEY=your_key_here
